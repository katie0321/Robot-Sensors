lidar = serial.Serial(
    "/dev/serial0",
    baudrate=115200,
    timeout=0.01
)


def read_tf_luna():
    # while True:
    #     if lidar.in_waiting:
    #         data = lidar.read(lidar.in_waiting)
    #         print(data)

    if lidar.in_waiting >= 9:
        data = lidar.read(9)

        if data[0] == 0x59 and data[1] == 0x59:
            distance = data[2] | (data[3] << 8)
            strength = data[4] | (data[5] << 8)
            temperature = ((data[6] | (data[7] << 8)) / 8) - 256

            return distance, strength, temperature

    return None, None, None


